REDIS_URL=redis://localhost:6379

R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=college-chatbot

PINECONE_API_KEY=
PINECONE_INDEX_NAME=college-chatbot

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Must match API_INTERNAL_SECRET in services/api/.env
API_INTERNAL_SECRET=

# Base URL of the Fastify API
API_BASE_URL=http://localhost:3000

# Worker concurrency
WORKER_CONCURRENCY=4

# F-17: Visual Content Intelligence
VISION_MODEL=claude-haiku-4-5-20251001
VISION_DETAIL=low
VISION_MAX_TOKENS=1024
VISION_BATCH_SIZE=5
VISION_BATCH_DELAY_SEC=1.0
IMAGE_MIN_WIDTH_PX=100
IMAGE_MIN_HEIGHT_PX=100
IMAGE_MIN_SIZE_BYTES=10000
IMAGE_MAX_ASPECT_RATIO=15
IMAGE_JPEG_QUALITY=85
IMAGE_THUMBNAIL_SIZE=200
IMAGE_THUMBNAIL_QUALITY=75
# Page-render fallback: DPI, min drawing paths, max text coverage ratio
PAGE_RENDER_DPI=150
PAGE_RENDER_MIN_DRAWINGS=20
# Lower threshold when page has an explicit "Figure X:" caption in its text
PAGE_RENDER_MIN_DRAWINGS_WITH_CAPTION=8
PAGE_RENDER_MAX_TEXT_RATIO=0.80
PAGE_RENDER_MIN_REGION_RATIO=0.12
CAPTION_ADJACENCY_PT=35
CLUSTER_GAP_PT=18
IMAGE_INGESTION_MAX_COST_USD=1.00

# F-19-B: Small-to-big hierarchical chunking
CHUNK_CHILD_TOKENS=350
CHUNK_CHILD_OVERLAP=40
CHUNK_PARENT_TOKENS=1400

# F-19-A: Contextual chunk enrichment
CONTEXTUALISER_ENABLED=true
CONTEXTUALISER_MODEL=claude-haiku-4-5-20251001
CONTEXTUALISER_MAX_TOKENS=150
CONTEXTUALISER_NEIGHBOR_PARENTS=1
CONTEXTUALISER_BATCH_SIZE=10
CONTEXTUALISER_VERSION=2

# F-19-F: True hybrid search — BM25 sparse encoding
# /bm25/fit and /bm25/encode-query require the same API_INTERNAL_SECRET as
# the ingestion callback webhooks above (Node authenticates to this worker).
